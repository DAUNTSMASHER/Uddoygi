# ─────────────────────────────────────────────────────────────────────────────
# PipraPay Backend — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=development

# PipraPay credentials (get from your PipraPay merchant dashboard)
PIPRAPAY_API_KEY=your_piprapay_api_key_here
PIPRAPAY_SANDBOX=true

# PipraPay base URLs (do not change unless PipraPay updates their API)
PIPRAPAY_SANDBOX_URL=https://sandbox.piprapay.com
PIPRAPAY_PRODUCTION_URL=https://pay.yourdomain.com

# Default URLs (override per-request if needed)
DEFAULT_REDIRECT_URL=https://yourapp.com/payment/success
DEFAULT_CANCEL_URL=https://yourapp.com/payment/cancel
DEFAULT_WEBHOOK_URL=https://yourserver.com/api/piprapay/webhook

# Security: a secret token your Flutter app sends in the Authorization header
# to authenticate requests to THIS backend (not the PipraPay API key).
BACKEND_SECRET_TOKEN=change_this_to_a_long_random_string

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://yourapp.com
