rules_version = '2';

// Storage rules for Uddoygi
// - payment_slips/*: used for payment proof uploads (marketing) and viewing (HR)
// - Authenticated users can read/write so proof upload and HR review work
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
